# SkillPulse Environment Configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# ── Database ─────────────────────────────────────────────
# PostgreSQL (production)
DATABASE_URL=postgresql://skillpulse_user:your_db_password@localhost:5432/skillpulse_db
# SQLite (local dev — used automatically if Postgres is unreachable)
# DATABASE_URL=sqlite:///./skillpulse.db

# ── Security ─────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-string

# ── Groq AI (https://console.groq.com) ───────────────────
# Create a free account, go to API Keys, generate a key starting with gsk_
AI_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
AI_API_KEY=gsk_your_groq_api_key_here
AI_MODEL=openai/gpt-oss-120b

# ── Frontend & Cloudflare Deployment ────────────────────
# Base URL of your deployed backend API (e.g. https://api.skillpulse.example.com)
# Leave blank when using Cloudflare Pages Functions proxy or local dev proxy
VITE_API_BASE_URL=
# Base path for deployment (default '/' for Cloudflare Pages; use '/skillpulse/' for GitHub Pages)
VITE_BASE_PATH=/
# For Cloudflare Pages Functions /api proxy (configured in Cloudflare Pages dashboard)
BACKEND_URL=
