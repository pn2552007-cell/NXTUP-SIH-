# NXTUP Frontend - Environment Configuration
# Copy this file to .env.local for local overrides.
# In Cloudflare Pages, configure these in: Project Settings -> Environment Variables.

# Backend API URL (optional: if omitted, requests default to relative '/api')
# Example: https://api.skillpulse.example.com
VITE_API_BASE_URL=

# Base path for deployment (default '/' for Cloudflare Pages / custom domains)
VITE_BASE_PATH=/
